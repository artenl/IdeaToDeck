# Copy to .env for local development (`uv run idea-eval serve`), or let install.sh
# write it for you on a server. Every setting in src/idea_eval/config.py can be set here.

# Required
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Models: workers always use CHEAP_MODEL; judge + strategist use DEEP_MODEL in deep mode.
# CHEAP_MODEL=claude-haiku-5-5
# DEEP_MODEL=claude-sonnet-5-5
# CHEAP_EFFORT=low
# DEEP_EFFORT=medium

# Research caps (the main cost levers)
# MAX_QUERIES=6
# RESULTS_PER_QUERY=5
# MAX_SOURCES=14
# MAX_RESEARCH_ROUNDS=2
# SEARCH_CACHE_DAYS=7

# Web app
# DATA_DIR=./data
# SESSION_SECRET=            # generated and stored in DATA_DIR if empty
# SECURE_COOKIES=false       # true when served over HTTPS
# DEFAULT_USER_MONTHLY_RUNS=10   # non-admin users; admins are unlimited
# MAX_CONCURRENT_RUNS=2
# MONTHLY_BUDGET_USD=0       # 0 = no global cap (admins always bypass it)

# Docker Compose (install.sh sets these)
# COMPOSE_PROJECT_NAME=isthisideagood
# COMPOSE_PROFILES=https     # starts Caddy for automatic HTTPS
# DOMAIN=ideas.example.com
# APP_BIND=127.0.0.1
# APP_PORT=8000
# FORWARDED_ALLOW_IPS=*
